<?xml version="1.0" encoding="UTF-8"?>
<ECommerceConnect xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:noNamespaceSchemaLocation="https://secure.upc.ua/go/pub/schema/xmlpay-1.32.xsd">
    <Message id="${__counter(FALSE)}" version="1.0">
        <XMLPayRequest>
            <RequestData>
                <MerchantID>${merchId}</MerchantID>
                <TerminalID>${termId}</TerminalID>
                <Transactions>
                    <Transaction>
                        <Authorization>
                            <PayData>
                                <Invoice>
                                    <OrderID>ferb${order_id}</OrderID>
                                    <Date>${data}</Date>
                                    <TotalAmount>${amount}</TotalAmount>
                                    <Currency>980</Currency>
                                    <Description>${description}</Description>
                                </Invoice>
                                <Card>
                                    <CardNum>${card_num}</CardNum>
                                    <ExpYear>${year}</ExpYear>
                                    <ExpMonth>${month}</ExpMonth>
                                    <CVNum>${cvv}</CVNum>
                                </Card>
                            </PayData>
                        </Authorization>
                    </Transaction>
                </Transactions>
            </RequestData>
        </XMLPayRequest>
    </Message>
</ECommerceConnect>
